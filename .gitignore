# =====================================================================
# Open Art Explorer - .gitignore
# Never commit secrets, signing material or machine-specific settings.
# =====================================================================

# --- Secrets and signing (never commit) ---
*.jks
*.keystore
*.p12
*.pem
keystore.properties
signing.properties
secrets.properties
.env
.env.*

# --- Local machine configuration ---
# local.properties holds the path to your Android SDK on this PC only.
local.properties

# --- Gradle ---
# The Gradle wrapper files (gradlew, gradlew.bat, gradle/wrapper/*) ARE
# committed on purpose, so they are not listed here.
.gradle/
build/
.kotlin/

# --- Android build outputs and tooling ---
# Release files are published through GitHub Releases, not committed.
*.apk
*.aab
*.ap_
captures/
.externalNativeBuild/
.cxx/
/out/

# --- Android Studio / IntelliJ ---
.idea/
*.iml

# --- VS Code ---
.vscode/

# --- Logs and temporary files ---
*.log
hs_err_pid*
replay_pid*
*.tmp
*.swp
*~

# --- Operating system files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/